android_app_import {
    name: "CalyxChromium",

    product_specific: true,
    certificate: ":chromium.certificate",
    compile_multilib: "both",
    optional_uses_libs: [
        "com.android.extensions.xr",
    ],
    overrides: [
        "Browser2",
        "QuickSearchBox",
    ],

    arch: {
        arm64: {
            apk: "arm64/ChromePublic.apk",
        },
        x86_64: {
            apk: "x64/ChromePublic.apk",
        },
    },
}

android_app_import {
    name: "CalyxWebView",

    product_specific: true,
    certificate: ":chromium.certificate",
    compile_multilib: "both",
    required: [
        "libwebviewchromium_loader",
        "libwebviewchromium_plat_support",
    ],
    optional_uses_libs: [
        "androidx.window.extensions",
        "com.android.extensions.xr",
    ],
    overrides: [
        "webview",
    ],

    arch: {
        arm64: {
            apk: "arm64/SystemWebView.apk",
        },
        x86_64: {
            apk: "x64/SystemWebView.apk",
        },
    },
}
