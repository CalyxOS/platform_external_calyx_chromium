soong_config_module_type {
    name: "calyx_chromium_app_import",
    module_type: "android_app_import",
    config_namespace: "calyx",
    bool_variables: ["use_presigned_apks"],
    properties: [
        "arch.arm64.apk",
        "arch.x86_64.apk",
        "certificate",
        "preprocessed",
        "presigned",
    ],
}

calyx_chromium_app_import {
    name: "TrichromeLibrary",

    product_specific: true,
    compile_multilib: "both",

    dex_preopt: {
        enabled: false,
    },

    soong_config_variables: {
        use_presigned_apks: {
            preprocessed: true,
            presigned: true,
            arch: {
                arm64: {
                    apk: "arm64/presigned/TrichromeLibrary6432.apk",
                },
                x86_64: {
                    apk: "x64/presigned/TrichromeLibrary6432.apk",
                },
            },
            conditions_default: {
                certificate: ":chromium.certificate",
                arch: {
                    arm64: {
                        apk: "arm64/TrichromeLibrary6432.apk",
                    },
                    x86_64: {
                        apk: "x64/TrichromeLibrary6432.apk",
                    },
                },
            },
        },
    },
}

calyx_chromium_app_import {
    name: "TrichromeWebView",

    product_specific: true,
    compile_multilib: "both",
    required: [
        "libwebviewchromium_loader",
        "libwebviewchromium_plat_support",
        "TrichromeLibrary",
    ],
    optional_uses_libs: ["androidx.window.extensions", "com.android.extensions.xr"],
    overrides: ["webview"],

    soong_config_variables: {
        use_presigned_apks: {
            preprocessed: true,
            presigned: true,
            arch: {
                arm64: {
                    apk: "arm64/presigned/TrichromeWebView6432.apk",
                },
                x86_64: {
                    apk: "x64/presigned/TrichromeWebView6432.apk",
                },
            },
            conditions_default: {
                certificate: ":chromium.certificate",
                arch: {
                    arm64: {
                        apk: "arm64/TrichromeWebView6432.apk",
                    },
                    x86_64: {
                        apk: "x64/TrichromeWebView6432.apk",
                    },
                },
            },
        },
    },
}

calyx_chromium_app_import {
    name: "TrichromeChrome",

    product_specific: true,
    compile_multilib: "both",
    required: ["TrichromeLibrary"],
    optional_uses_libs: ["com.android.extensions.xr"],
    overrides: [
        "Browser2",
        "QuickSearchBox",
    ],

    soong_config_variables: {
        use_presigned_apks: {
            preprocessed: true,
            presigned: true,
            arch: {
                arm64: {
                    apk: "arm64/presigned/universal.apk",
                },
                x86_64: {
                    apk: "x64/presigned/universal.apk",
                },
            },
            conditions_default: {
                certificate: ":chromium.certificate",
                arch: {
                    arm64: {
                        apk: "arm64/universal.apk",
                    },
                    x86_64: {
                        apk: "x64/universal.apk",
                    },
                },
            },
        },
    },
}
